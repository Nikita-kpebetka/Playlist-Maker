<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://android.com"
    android:id="@+id/nav_graph"
    app:startDestination="@id/fragmentMediaLibrary">


    <fragment
        android:id="@+id/fragmentSearch"
        android:name="com.practicum.playlistmaker.search.ui.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search">

        <action
            android:id="@+id/action_fragmentSearch_to_fragmentAudioPlayer"
            app:destination="@id/fragmentAudioPlayer" />

    </fragment>

    <fragment
        android:id="@+id/fragmentMediaLibrary"
        android:name="com.practicum.playlistmaker.library.ui.MediaLibraryFragment"
        android:label="fragment_media_library"
        tools:layout="@layout/fragment_media_library">
        <action
            android:id="@+id/action_fragmentMediaLibrary_to_fragmentAudioPlayer"
            app:destination="@id/fragmentAudioPlayer" />
        <action
            android:id="@+id/action_fragmentMediaLibrary_to_newPlaylistFragment"
            app:destination="@id/newPlaylistFragment" />
        <action
            android:id="@+id/action_fragmentMediaLibrary_to_playlistDetailsFragment"
            app:destination="@id/playlistDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/fragmentSettings"
        android:name="com.practicum.playlistmaker.settings.ui.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/fragmentAudioPlayer"
        android:name="com.practicum.playlistmaker.player.ui.AudioPlayerFragment"
        android:label="fragment_audio_player"
        tools:layout="@layout/fragment_audio_player">
        <action
            android:id="@+id/action_fragmentAudioPlayer_to_newPlaylistFragment"
            app:destination="@id/newPlaylistFragment" />
    </fragment>

    <fragment
        android:id="@+id/newPlaylistFragment"
        android:name="com.practicum.playlistmaker.library.ui.NewPlaylistFragment"
        android:label="fragment_new_playlist"
        tools:layout="@layout/fragment_new_playlist" />

    <fragment
        android:id="@+id/playlistDetailsFragment"
        android:name="com.practicum.playlistmaker.library.ui.PlaylistDetailsFragment"
        android:label="fragment_playlist_details"
        tools:layout="@layout/fragment_playlist_details">

        <argument
            android:name="playlist_id_data"
            app:argType="integer" />

        <action
            android:id="@+id/action_playlistDetailsFragment_to_fragmentAudioPlayer"
            app:destination="@id/fragmentAudioPlayer" />

        <action
            android:id="@+id/action_playlistDetailsFragment_to_editPlaylistFragment"
            app:destination="@id/editPlaylistFragment" />
    </fragment>

    <fragment
        android:id="@+id/editPlaylistFragment"
        android:name="com.practicum.playlistmaker.library.ui.EditPlaylistFragment"
        android:label="fragment_edit_playlist"
        tools:layout="@layout/fragment_new_playlist" />

</navigation>