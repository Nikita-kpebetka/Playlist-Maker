<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheetMenu"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white_background"
    android:paddingBottom="24dp">

    <View
        android:id="@+id/dragHandle"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_drag_handle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/playlistItem"
        layout="@layout/item_bottom_sheet_playlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/dragHandle" />

    <TextView
        android:id="@+id/btnMenuShare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingVertical="16dp"
        android:paddingHorizontal="16dp"
        android:text="@string/share"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:background="@color/white_background"
        app:layout_constraintTop_toBottomOf="@id/playlistItem" />

    <TextView
        android:id="@+id/btnMenuEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:paddingHorizontal="16dp"
        android:text="@string/edit_playlist"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:fontFamily="@font/ys_display_regular"
        android:background="@color/white_background"
        app:layout_constraintTop_toBottomOf="@id/btnMenuShare" />

    <TextView
        android:id="@+id/btnMenuDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:paddingHorizontal="16dp"
        android:text="@string/delete_playlist"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:fontFamily="@font/ys_display_regular"
        android:background="@color/white_background"
        app:layout_constraintTop_toBottomOf="@id/btnMenuEdit" />

</androidx.constraintlayout.widget.ConstraintLayout>