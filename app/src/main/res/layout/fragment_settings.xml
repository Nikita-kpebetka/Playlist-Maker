<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/Settings_screen_template"
    tools:layout="@layout/fragment_settings"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvSearchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:text="@string/settings"
        android:fontFamily="@font/ys_display_bold"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="22sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_item_height"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="@dimen/standard_margin">

            <TextView
                style="@style/Settings_text"
                android:text="@string/dark_theme" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/themeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                app:thumbTint="@color/white"
                app:trackTint="#00D6C3" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/shareApp"
            style="@style/Settings_button_template">

            <TextView
                style="@style/Settings_text"
                android:text="@string/share_app" />

            <ImageView
                android:layout_gravity="center_vertical|end"
                android:src="@drawable/ic_share"
                style="@style/Settings_icon"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/writeSupport"
            style="@style/Settings_button_template">

            <TextView
                style="@style/Settings_text"
                android:text="@string/write_to_support" />

            <ImageView
                android:layout_gravity="center_vertical|end"
                android:src="@drawable/ic_support"
                style="@style/Settings_icon"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/userAgreement"
            style="@style/Settings_button_template">

            <TextView
                style="@style/Settings_text"
                android:text="@string/user_agreement" />

            <ImageView
                style="@style/Settings_icon"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:src="@drawable/ic_arrow_forward" />
        </FrameLayout>


    </LinearLayout>